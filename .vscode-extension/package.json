{
  "name": "opencode-swarm",
  "displayName": "Opencode Swarm",
  "description": "Multi-agent coding swarm status and timeline in VS Code",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "opencode-swarm.showTimeline", "title": "Swarm: Show Timeline" },
      { "command": "opencode-swarm.newRun", "title": "Swarm: New Run" }
    ]
  }
}
